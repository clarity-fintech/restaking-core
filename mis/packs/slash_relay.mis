  invariant kernel_is_misc: compiler_kernel == misc;
  invariant pack_slash_relay_bound: pack_bound == true;
  invariant catalog_backlink: mis_catalog_bound == true;

  invariant slash_relay_081: slash_relay_081_bound == true;
